// jass grammar.
//
// Parsed with LALR(1) and a contextual lexer. The grammar recognizes shapes and
// enforces only structural order (section order, no dangling `or`, positional
// args before named ones); everything value/domain/type related is deferred to
// the semantic analyzer. Keywords are explicit string terminals so they outrank
// the NAME identifier pattern, and the value terminals (DURATION, NUMBER, ENTITY)
// are written so longest-match keeps them unambiguous.

// ===== rules =====

start: top_item*
?top_item: def_binding | automation

// A compile-time alias binding: file-level (global) or block-level.
def_binding: DEF NAME ASSIGN value

automation: AUTOMATION STRING? LBRACE metadata* when_block condition_block? do_block RBRACE

// description=, mode=, max= — validated by the analyzer, not the grammar.
metadata: NAME ASSIGN value

// ----- triggers -----
when_block: WHEN LPAR trigger (OR trigger)* RPAR
trigger: trigger_expr (AS STRING)?
?trigger_expr: state_trigger
             | numeric_trigger
             | time_trigger
             | sun_trigger
state_trigger:   entity CHANGES (FROM value)? (TO value)? (FOR DURATION)?
numeric_trigger: entity (LT | GT) threshold (FOR DURATION)?
time_trigger:    TIME
sun_trigger:     sun_event

// ----- conditions -----
condition_block: IF LPAR bool_expr RPAR

?bool_expr: or_expr
?or_expr:  and_expr (OR and_expr)*
?and_expr: not_expr (AND not_expr)*
?not_expr: NOT not_expr
         | atom
?atom: LPAR bool_expr RPAR
     | condition
?condition: state_condition
          | numeric_condition
          | time_condition
          | day_condition
          | sun_condition
          | triggeredby_condition
state_condition:       entity (EQ | NE) value
numeric_condition:     entity (LT | GT) threshold
time_condition:        (AFTER | BEFORE) TIME
day_condition:         ON list
sun_condition:         (AFTER | BEFORE) sun_event
triggeredby_condition: TRIGGEREDBY STRING

// A numeric threshold: a literal number or an alias standing in for one.
?threshold: NUMBER -> number
          | NAME   -> alias_ref

// sunrise/sunset with an optional signed offset (shared by triggers & conditions).
sun_event: (SUNSET | SUNRISE) ((PLUS | MINUS) DURATION)?

// ----- actions -----
do_block: DO block
block: LBRACE statement* RBRACE

?statement: action_call
          | if_statement
          | safe_block
          | def_binding

action_call: NAME LPAR arguments? RPAR
// Positional arguments must precede named ones (enforced structurally).
arguments: pos_args
         | pos_args COMMA kw_args
         | kw_args
pos_args: value
        | pos_args COMMA value
kw_args: named_arg
       | kw_args COMMA named_arg
named_arg: NAME ASSIGN value

if_statement: IF LPAR bool_expr RPAR block elif_clause* else_clause?
elif_clause: ELIF LPAR bool_expr RPAR block
else_clause: ELSE block

safe_block: SAFE block

// ----- values -----
// An entity position accepts a direct reference or an alias standing in for one.
entity: ENTITY -> entity_ref
      | NAME   -> alias_ref

?value: STRING   -> string
      | NUMBER   -> number
      | TRUE     -> true
      | FALSE    -> false
      | DURATION -> duration
      | TIME     -> time_value
      | ENTITY   -> entity_ref
      | NAME     -> alias_ref
      | list
      | dict
      | color

list:  LBRACKET (value (COMMA value)*)? RBRACKET
dict:  LBRACE (pair (COMMA pair)*)? RBRACE
pair:  STRING COLON value
color: RGB LPAR NUMBER COMMA NUMBER COMMA NUMBER RPAR

// ===== terminals =====
//
// Terminals are defined below (increment 1 — lexing).

// ----- keywords -----
AUTOMATION:  "automation"
WHEN:        "when"
DO:          "do"
IF:          "if"
ELIF:        "elif"
ELSE:        "else"
SAFE:        "safe"
DEF:         "def"
CHANGES:     "changes"
FROM:        "from"
TO:          "to"
FOR:         "for"
AS:          "as"
OR:          "or"
AND:         "and"
NOT:         "not"
AFTER:       "after"
BEFORE:      "before"
ON:          "on"
SUNSET:      "sunset"
SUNRISE:     "sunrise"
TRIGGEREDBY: "triggeredby"
TRUE:        "True"
FALSE:       "False"
RGB:         "rgb"

// ----- operators & punctuation -----
EQ:       "=="
NE:       "!="
ASSIGN:   "="
LT:       "<"
GT:       ">"
PLUS:     "+"
MINUS:    "-"
LPAR:     "("
RPAR:     ")"
LBRACE:   "{"
RBRACE:   "}"
LBRACKET: "["
RBRACKET: "]"
COMMA:    ","
COLON:    ":"

// ----- values -----
// A time literal: @HH:MM:SS (one token so ':' stays free for dicts).
TIME:     /@\d{2}:\d{2}:\d{2}/
// A duration: any of h/m/s units in order, at least one present (e.g. 1h30m, 45s).
DURATION: /\d+h(\d+m)?(\d+s)?|\d+m(\d+s)?|\d+s/
// An (unsigned) integer or float; floats handled first for longest-match.
NUMBER:   /\d+\.\d+|\d+/
// An entity reference: lowercase domain, then '.', then the object id (may start
// with a digit, e.g. alarm_control_panel.37dc24).
ENTITY:   /[a-z][a-z_]*\.[a-z0-9_]+/
// An identifier: action names, parameter names and alias names.
NAME:     /[a-zA-Z_][a-zA-Z0-9_]*/
// A double-quoted string (supports backslash escapes).
STRING:   /"(\\.|[^"\\])*"/

// ----- ignored -----
COMMENT: /\/\/[^\n]*/
%ignore COMMENT
%ignore /[ \t\f\r\n]+/
