// automation [NAME] { ... }
automation "Climate Comfort" {
    // metadata
    description = "Adjusts home based on temperature and presence"
    mode = "queued"
    max = 5

    // trigger (when):
    // - at least one required
    // - separated by ors
    // - 'as' assigns an id for later reference with 'triggeredby'
    when (
        // state trigger:
        // - changes [from VAL] [to VAL] [for DURATION]
        // - from/to accept a single value or a list
        binary_sensor.hallway changes to "on" as "presence" or
        light.living_room changes from ["off", "unavailable"] to "on" as "lamp_on" or
        binary_sensor.hallway changes to "off" for 10m as "no_motion" or
        binary_sensor.bedroom changes from "off" to "on" for 5m as "no_motion" or // multiple triggers with the same id are allowed, they will all be referenced by that id in 'triggeredby'

        // time trigger:
        // - (HH:MM:SS)
        @07:00:00 as "morning" or
        @23:00:00 as "bedtime" or

        // sun triggers:
        // - sunrise/sunset with optional offset
        sunset - 30m as "dusk" or
        sunrise as "dawn" or

        // numeric trigger:
        // - supports < and >
        sensor.outside_temperature > 30 for 5m as "hot" or
        sensor.outside_temperature < 5.3 as "cold"

        // not supported:
        // sensor.outside_temperature == 5.3
        // sensor.outside_temperature != 5
    )

    // conditions:
    // - optional
    if (
        // state conditions:
        // - ENTITY == STATE
        binary_sensor.hallway == "on" and
        light.living_room == "on" and
        climate.home != "off" and

        // time conditions:
        // - after TIME
        // - before TIME
        // - on [DAY, ...]
        after @06:00:00 and
        before @23:00:00 and
        on ["mon", "tue", "wed", "thu", "fri"] and

        // sun conditions:
        // - after/before sunrise/sunset with optional offset
        before sunset + 10m and
        after sunrise and

        // support for logical operators, like Python
        not (sensor.outside_temperature > 28 or weather.forecast_home == "sunny" or triggeredby "no_motion")

        // like the triggers, only > and < are supported for numbers

        // precedence must follow python rules, parentheses can be used to change precedence and improve readability
    )

    // actions
    // collection of statements, executed sequentially
    do {
        turn_on(light.living_room, color=rgb(255, 0, 0))
        turn_off(light.kitchen)
        toggle(switch.porch)

        // semantic rules should be defined from the domain
        // for examples, it knows its a light, so the compiler will translate to light.turn_on
        // the passed parameters are defined in the compiler itself and not validated externally
        // so it also knows that transition receives a duration for example
        turn_on([light.living_room, light.kitchen], brightness=50, transition=5s)

        // turn_on([light.abc, switch.fds]) // compile error since entities are from different domains

        // position arguments are implicit named parameters, so both are equivalent:
        delay(3s)
        delay(duration=1h30m)

        turn_on(target=light.living_room)

        // positional arguments should always come before named arguments
        say(tts.google_tts, message="Temperature is high")

        run(automation.close_garage, skip_condition=True)

        // The compiler blindly translates this into a standard service call block
        call("vacuum.send_command", target=vacuum.roomba, data={"command": "start", "params": [12, 0.3]})

        // triggeredby <ID> allows conditionally running actions based on which trigger fired
        // the same conditions of the automation apply, so you can check states, time, sun, etc. in combination with triggeredby 
        if (triggeredby "presence") {
        }
        elif (triggeredby "hot") {
        }
        elif (weather.forecast_home == "rainy" or sensor.outside_temperature < 10 and triggeredby "dusk") {
        }
        // ((not (light.living_room == "on")) and (binary_sensor.hallway != "on"))
        elif (not light.living_room == "on" and binary_sensor.hallway != "on") {
        }
        else {
            turn_on(switch.abc31)
        }

        // continue on error
        // HA has a sequence block that can group actions so this is possible in the newest version
        safe {
            say(tts.google_tts, message="Turning on the lights")
        }
    }
}

// minimal automation:
// - single trigger
// - no conditions
// - empty actions
automation "small" {
    when (binary_sensor.hallway changes to "on")
    do { }
}